project_slug: pandapower-qgis

# Keep the plugin directory inside the zip as "pandapower-qgis". That is the
# package name the plugin is registered under on plugins.qgis.org (plugin 3020),
# and the repository identifies plugins by it: a package unpacking to any other
# directory is treated as a different plugin, so the upload is rejected and
# existing installs never see the update. QGIS loads plugins with
# __import__(name), which accepts the dash.
use_project_slug_as_plugin_directory: false
